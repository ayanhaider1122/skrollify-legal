rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // 1. Private user profile & daily stats backup (only that user can read/write)
    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /daily_stats/{dateKey} {
        allow read, write: if isOwner(uid);
      }
    }

    // 2. Friend Circles / Groups (keyed by globally unique uppercase invite code, e.g. SK-7K4M-9P2X)
    match /groups/{inviteCode} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && (
        resource.data.ownerUid == request.auth.uid
        || (resource.data.memberUids is list && request.auth.uid in resource.data.memberUids)
      );

      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberUids is list
        && request.auth.uid in request.resource.data.memberUids
        && request.resource.data.maxCapacity is int
        && request.resource.data.maxCapacity >= 1
        && request.resource.data.maxCapacity <= 15;

      allow update: if isSignedIn() && (
        resource.data.ownerUid == request.auth.uid
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'updatedAtMs'])
          && resource.data.isInviteRevoked != true
          && request.resource.data.memberUids is list
          && !(request.auth.uid in resource.data.memberUids)
          && request.auth.uid in request.resource.data.memberUids
          && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
          && request.resource.data.memberUids.size() <= resource.data.maxCapacity
          && request.resource.data.memberUids.hasAll(resource.data.memberUids)
        )
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'updatedAtMs'])
          && request.auth.uid in resource.data.memberUids
          && !(request.auth.uid in request.resource.data.memberUids)
          && request.resource.data.memberUids.size() == resource.data.memberUids.size() - 1
          && resource.data.memberUids.hasAll(request.resource.data.memberUids)
        )
      );

      allow delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;

      match /members/{memberUid} {
        allow read: if isSignedIn() && (
          request.auth.uid == memberUid
          || request.auth.uid in get(/databases/$(database)/documents/groups/$(inviteCode)).data.memberUids
        );
        allow create, update: if isSignedIn()
          && request.auth.uid == memberUid
          && request.auth.uid in getAfter(/databases/$(database)/documents/groups/$(inviteCode)).data.memberUids;
        allow delete: if isSignedIn() && (
          request.auth.uid == memberUid
          || get(/databases/$(database)/documents/groups/$(inviteCode)).data.ownerUid == request.auth.uid
        );
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
